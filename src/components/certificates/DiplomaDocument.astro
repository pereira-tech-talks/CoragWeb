---
import type { CertificatePayload } from '@/lib/certificates/types';
/**
 * Print-grade diploma document (elevated from PR #297 / feature/cert).
 * Uses Corag / edition tokens; no Roboto or emoji.
 */
import { formatCalendarDate, formatInstantInSiteTimezone } from '@/lib/dates';
import type { Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  certificate: CertificatePayload;
  verificationUrl: string;
  qrDataUrl: string;
  lang: Language;
  logoSrc?: string;
}

const {
  certificate,
  verificationUrl,
  qrDataUrl,
  lang,
  logoSrc = '/images/pereira-tech-days/2026/mascot/hero.webp',
} = Astro.props;

const t = getTranslations(lang);
const locale = lang === 'es' ? 'es-CO' : 'en-US';

const eventDate = new Date(`${certificate.event.date}T00:00:00.000Z`);
const formattedDate = formatCalendarDate(eventDate, lang, {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const issuedDate = new Date(certificate.issuedAt);
const formattedIssued = formatInstantInSiteTimezone(issuedDate, locale);

const roleLabel = t.certificates.roles[certificate.subject.role];
const isRevoked = certificate.status === 'revoked';
const watermark = isRevoked ? t.certificates.watermarkRevoked : undefined;
---

<div
  class:list={['corag-cert', isRevoked && 'corag-cert--revoked']}
  data-testid="diploma-document"
  data-cert-id={certificate.id}
  data-watermark={watermark}
>
  <div class="corag-cert__motif" aria-hidden="true"></div>
  <div class="corag-cert__border-top" aria-hidden="true"></div>
  <div class="corag-cert__body">
    <header class="corag-cert__header">
      <img
        src={logoSrc}
        alt=""
        width="120"
        height="80"
        class="corag-cert__logo"
        loading="eager"
        decoding="async"
      />
      <h1 class="corag-cert__title">{t.certificates.diplomaTitle}</h1>
    </header>

    <hr class="corag-cert__divider" />

    <div class="corag-cert__content">
      <p class="corag-cert__preamble">{t.certificates.preamble}</p>
      <p class="corag-cert__subject-name">{certificate.subject.name}</p>
      <p class="corag-cert__event-line">
        {t.certificates.attendedPrefix}
        {' '}
        <span class="corag-cert__event-name">{certificate.event.name}</span>
      </p>
      <p class="corag-cert__event-line">
        {formattedDate}{certificate.event.location ? ` · ${certificate.event.location}` : ''}
      </p>
      <span class="corag-cert__role">{roleLabel}</span>
    </div>

    <footer class="corag-cert__footer">
      <div class="corag-cert__footer-left">
        <div class="corag-cert__seal" aria-hidden="true">
          <span class="corag-cert__seal-label">{t.certificates.sealLabel}</span>
        </div>
        <span class="corag-cert__issuer">
          {t.certificates.issuedBy} {certificate.issuer.name}
        </span>
        <span class="corag-cert__issued-date">{formattedIssued}</span>
      </div>
      <div class="corag-cert__footer-right">
        <a href={verificationUrl} class="corag-cert__qr-link">
          <img
            src={qrDataUrl}
            alt={t.certificates.qrAlt}
            width="72"
            height="72"
            class="corag-cert__qr"
          />
        </a>
        <span class="corag-cert__verify-label">{t.certificates.verifyLabel}</span>
        <span class="corag-cert__cert-id" title={certificate.id}>{certificate.id}</span>
      </div>
    </footer>
  </div>
</div>

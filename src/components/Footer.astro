---
import { SOCIAL_LINKS } from '@/lib/constances';
import { getTodayInSiteTimezone } from '@/lib/dates';
import { DEFAULT_LANGUAGE, getUrlPrefix } from '@/lib/i18n';
import { navHref, navLabel, SITE_NAVIGATION } from '@/lib/site-navigation';
import type { Language } from '@/lib/translations';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang?: string;
  /**
   * `ptd-dark` — matches navy PTD edition pages (2024): solid page bg, hairline
   * border, white copy. `default` keeps the global Corag footer.
   */
}

const { lang = DEFAULT_LANGUAGE } = Astro.props;
const t = getTranslations(lang as Language);
const prefix = getUrlPrefix(lang as Language);
const year = Number.parseInt(getTodayInSiteTimezone().slice(0, 4), 10);

// Derived from the shared navigation module so the footer, the header, and the
// agent-Markdown Site Navigation block cannot disagree about what the site
// exposes. See `src/lib/site-navigation.ts`.
const EXPLORE_PATHS = [
  '/meetups',
  '/pereira-tech-day',
  '/speakers',
  '/blog',
  '/sponsors',
];
const COMMUNITY_PATHS = [
  '/about',
  '/communities',
  '/contributing',
  '/governance',
  '/conduct',
  '/channels',
  '/press',
];

const pick = (paths: string[]) =>
  paths.flatMap((path) => {
    const entry = SITE_NAVIGATION.flatMap((g) => g.entries).find(
      (e) => e.path === path
    );
    return entry
      ? [{ label: navLabel(entry, lang), href: navHref(entry, lang) }]
      : [];
  });

const explore = pick(EXPLORE_PATHS);

const utilityLinks = [
  {
    label: lang === 'es' ? 'Contacto' : 'Contact',
    href: `${prefix}/contact`,
    item: 'contact',
  },
];

const community = pick(COMMUNITY_PATHS);

const tagline = t.footer.tagline;
---

<footer
  class="relative border-t border-corag-border bg-corag-bg text-corag-secondary"
  style="padding-bottom: max(2rem, env(safe-area-inset-bottom)); padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right);"
>
  <div
    class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-corag-primary via-corag-accent to-corag-primary"
    aria-hidden="true"
  >
  </div>

  <div class="main-container pt-14 pb-10">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5 text-left">
        <a
          href={prefix || '/'}
          class="inline-flex items-center"
          aria-label="Corag"
        >
          <img
            src="/images/brand/corag-wordmark.webp"
            alt=""
            width={342}
            height={100}
            class="h-12 w-auto dark:hidden sm:h-14"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/images/brand/corag-wordmark-light.webp"
            alt=""
            width={342}
            height={100}
            class="hidden h-12 w-auto dark:block sm:h-14"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p
          class:list={[
            'mt-4 max-w-sm text-sm leading-relaxed',
            'text-corag-secondary',
          ]}
        >
          {tagline}
        </p>
        <ul class="mt-6 flex gap-2" role="list">
          {
            SOCIAL_LINKS.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-corag-border text-corag-secondary transition-colors hover:border-corag-primary hover:text-corag"
                  aria-label={social.label}
                  data-umami-event="social_click"
                  data-umami-event-platform={social.icon}
                >
                  <img
                    src={`/icons/${social.icon}.svg`}
                    alt=""
                    width={20}
                    height={20}
                    loading="lazy"
                    decoding="async"
                    class="h-5 w-5 dark:hidden"
                  />
                  <img
                    src={`/icons/${social.icon}_white.svg`}
                    alt=""
                    width={20}
                    height={20}
                    loading="lazy"
                    decoding="async"
                    class="hidden h-5 w-5 dark:block"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav
        aria-label={lang === 'es' ? 'Explorar' : 'Explore'}
        class="lg:col-span-3 text-left"
      >
        <p
          class:list={[
            'text-xs uppercase tracking-widest',
            'font-semibold text-corag-primary',
          ]}
        >
          {lang === 'es' ? 'Explorar' : 'Explore'}
        </p>
        <ul class="mt-4 space-y-1">
          {
            explore.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'inline-flex min-h-[44px] items-center text-sm transition-colors',
                    'text-corag-secondary hover:text-corag-primary',
                  ]}
                  data-umami-event="nav_click"
                  data-umami-event-item={link.href.split('/').filter(Boolean).pop() ?? 'home'}
                  data-umami-event-source="footer"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        aria-label={lang === 'es' ? 'Comunidad' : 'Community'}
        class="lg:col-span-4 text-left"
      >
        <p
          class:list={[
            'text-xs uppercase tracking-widest',
            'font-semibold text-corag-primary',
          ]}
        >
          {lang === 'es' ? 'Comunidad' : 'Community'}
        </p>
        <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
          {
            community.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'inline-flex min-h-[44px] items-center text-sm transition-colors',
                    'text-corag-secondary hover:text-corag-primary',
                  ]}
                  data-umami-event="nav_click"
                  data-umami-event-item={link.href.split('/').filter(Boolean).pop() ?? 'home'}
                  data-umami-event-source="footer"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class:list={[
        'mt-12 flex flex-col gap-5 border-t pt-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8',
        'border-corag-border',
      ]}
    >
      <p
        class:list={[
          'text-sm leading-relaxed',
          'text-corag-secondary',
        ]}
      >
        &copy; {year}{' '}
        {t.footer.copyright}. {t.footer.allRightsReserved}
      </p>
      <nav
        aria-label={lang === 'es' ? 'Enlaces rápidos' : 'Quick links'}
        class="flex flex-wrap items-center gap-x-6 gap-y-2"
      >
        {
          utilityLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'inline-flex min-h-[44px] items-center text-sm font-bold tracking-wide hover:underline',
                'text-corag-primary',
              ]}
              data-umami-event="nav_click"
              data-umami-event-item={link.item}
              data-umami-event-source="footer"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

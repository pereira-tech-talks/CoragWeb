---
/**
 * Corag home page.
 *
 * Structure follows the six-beat argument in `docs/MESSAGING.md`:
 *   1 la intención existe → 2 la conexión falla → 3 Corag es el puente →
 *   4 el puente se sostiene con evidencia → 5 Ayuda Directa → 6 únete al movimiento
 *
 * The home page is the only surface that runs all six beats.
 */
import BlogPreviewSection from '@/components/home/BlogPreviewSection.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { appUrl, getDefaultOgImage } from '@/lib/constances';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
const h = t.home;
---

<MainLayout
  lang={lang}
  title={t.siteTitleFull}
  description={t.siteDescription}
  image={getDefaultOgImage(lang)}
  preloadHeaderLogo={false}
>
  {/* ── Beat 3 + the coraje statement ───────────────────────────────── */}
  <section class="bg-corag-bg-dark">
    <div class="main-container py-20 sm:py-28">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-rosa"
        >
          {h.eyebrow}
        </p>
        <h1
          class="mt-4 font-display text-4xl font-bold leading-tight text-corag-on-fill sm:text-5xl md:text-6xl"
        >
          {h.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-corag-rosa">
          {h.lead}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={appUrl('/aportar')}
            class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-corag-rosa px-7 py-3 font-semibold text-corag-bg-dark transition-colors hover:bg-corag-rosa-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-rosa"
          >
            {h.ctaPrimary}
          </a>
          <a
            href={`${prefix}/como-funciona`}
            class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-corag-rosa/60 px-7 py-3 font-semibold text-corag-rosa transition-colors hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-rosa"
          >
            {h.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </section>

  <div id="main-after-hero"></div>

  {/* ── Beats 1 + 2 — intent exists, connection fails ────────────────── */}
  <section class="bg-corag-bg">
    <div class="main-container py-16 sm:py-20">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl font-semibold text-corag sm:text-3xl">
          {h.problemTitle}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-corag-secondary">
          {h.problemBody}
        </p>
      </div>
    </div>
  </section>

  {/* ── Beat 4 — the bridge holds because of evidence ────────────────── */}
  <section class="bg-corag-bg-brand">
    <div class="main-container py-16 sm:py-20">
      <h2 class="font-display text-2xl font-semibold text-corag sm:text-3xl">
        {h.trustTitle}
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-corag-secondary">
        {h.trustBody}
      </p>
      <dl class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          h.pillars.map((pillar) => (
            <div class="rounded-[18px] border border-corag-border bg-corag-bg-elevated p-6 shadow-corag-sm">
              <dt class="font-display text-lg font-semibold text-corag">
                {pillar.title}
              </dt>
              <dd class="mt-2 text-corag-secondary">{pillar.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ── Beat 5 + 6 — Ayuda Directa, then the invitation ──────────────── */}
  <section class="bg-corag-bg">
    <div class="main-container py-16 sm:py-20">
      <div
        class="rounded-[28px] bg-corag-fill px-6 py-12 text-center sm:px-12 sm:py-16"
      >
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-rosa"
        >
          {h.productEyebrow}
        </p>
        <h2
          class="mt-3 font-display text-3xl font-bold text-corag-on-fill sm:text-4xl"
        >
          {h.productTitle}
        </h2>
        <p
          class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-corag-rosa"
        >
          {h.productBody}
        </p>
        <a
          href={appUrl('/')}
          class="mt-8 inline-flex min-h-[44px] items-center gap-2 rounded-full bg-corag-rosa px-7 py-3 font-semibold text-corag-bg-dark transition-colors hover:bg-corag-rosa-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-rosa"
        >
          {h.productCta}
        </a>
      </div>
    </div>
  </section>

  <BlogPreviewSection lang={lang} />
  <ContactSection lang={lang} />
</MainLayout>

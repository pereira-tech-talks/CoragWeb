---
/**
 * Corag home page.
 *
 * The only surface that runs all six beats of the argument in `docs/MESSAGING.md`:
 *   1 la intención existe → 2 la conexión falla → 3 Corag es el puente →
 *   4 el puente se sostiene con evidencia → 5 Ayuda Directa → 6 únete al movimiento
 *
 * Deliberately static. No live figures are baked into the build: a stale
 * humanitarian number damages trust more than no number, so every count lives in
 * the application and we link to it.
 */
import BlogPreviewSection from '@/components/home/BlogPreviewSection.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { APP_URL, appUrl, getDefaultOgImage } from '@/lib/constances';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const h = t.home;

/*
 * Route slugs are English in both languages (repo rule 21); Spanish is served
 * unprefixed and English under `/en`.
 */
const prefix = getUrlPrefix(lang);
const routes = {
  how: `${prefix}/how-it-works`,
  trust: `${prefix}/transparency`,
  dev: `${prefix}/developers`,
  team: `${prefix}/contributors`,
};

const btnPrimary =
  'inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full bg-corag-fill px-7 py-3 font-semibold text-corag-on-fill transition-colors hover:bg-corag-fill-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-primary';
const btnOnDark =
  'inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full bg-corag-rosa px-7 py-3 font-semibold text-corag-bg-dark transition-colors hover:bg-corag-rosa-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-rosa';
const btnGhostOnDark =
  'inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full border border-corag-rosa/50 px-7 py-3 font-semibold text-corag-rosa transition-colors hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-rosa';
const btnSecondary =
  'inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full border border-corag-primary px-7 py-3 font-semibold text-corag-primary transition-colors hover:bg-corag-primary-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-primary';
---

<MainLayout
  lang={lang}
  title={t.siteTitleFull}
  description={t.siteDescription}
  image={getDefaultOgImage(lang)}
  preloadHeaderLogo={false}
  lcpImageHref="/images/home/hero-caritas-45-648.webp"
>
  {/* ── Beat 3 + the coraje statement ─────────────────────────────────── */}
  <section class="relative overflow-hidden bg-corag-bg-dark">
    {/* Brand heart motif — decorative, clipped on the right edge */}
    <svg
      class="pointer-events-none absolute -right-48 top-1/2 h-[42rem] w-[42rem] -translate-y-1/2 text-corag-rosa opacity-[0.06]"
      viewBox="0 0 512 512"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M256 434 C 150 352, 84 290, 84 210 C 84 148, 132 106, 190 106 C 226 106, 246 124, 256 142 C 266 124, 286 106, 322 106 C 380 106, 428 148, 428 210 C 428 290, 362 352, 256 434 Z"
        stroke="currentColor"
        stroke-width="22"
        stroke-linecap="round"
        stroke-linejoin="round"
        transform="rotate(-18 256 256)"></path>
    </svg>
    <div
      class="hero-glow pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full"
      aria-hidden="true"
    >
    </div>
    <div
      class="main-container relative py-20 sm:py-24 lg:flex lg:min-h-[88vh] lg:items-center"
    >
      <div class="grid w-full items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-rosa"
          >
            {h.eyebrow}
          </p>
          <h1
            class="mt-4 font-display text-5xl font-bold leading-[1.02] tracking-tight text-corag-on-fill sm:text-6xl lg:text-7xl"
          >
            {h.title}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-corag-rosa">
            {h.lead}
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href={appUrl('/aportar')} class={btnOnDark}>{h.ctaPrimary}</a>
            <a href={routes.how} class={btnGhostOnDark}>{h.ctaSecondary}</a>
          </div>
          <ul class="mt-10 flex flex-wrap gap-3" role="list">
            {
              h.heroChips.map((chip) => (
                <li class="rounded-full border border-white/15 px-4 py-1.5 text-sm font-medium text-corag-rosa">
                  {chip}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="relative lg:col-span-6">
          <img
            src="/images/home/hero-caritas-45-648.webp"
            srcset="/images/home/hero-caritas-45-480.webp 480w, /images/home/hero-caritas-45-648.webp 648w"
            sizes="(min-width: 1024px) 40vw, 100vw"
            alt={h.productPhotoAlt}
            width={648}
            height={810}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full rounded-[28px] object-cover shadow-corag-lg"
          />
          {/* Mini app card — the product, present from the first viewport */}
          <div
            class="absolute -bottom-8 -left-4 hidden w-56 overflow-hidden rounded-[18px] border border-white/10 bg-corag-bg-dark shadow-corag-lg sm:block lg:-left-10 lg:w-64"
          >
            <div class="aspect-[3/4]">
              <img
                src="/images/home/app/app-home-mobile-390.webp"
                srcset="/images/home/app/app-home-mobile-390.webp 390w, /images/home/app/app-home-mobile-780.webp 780w"
                sizes="16rem"
                alt={h.heroAppCardAlt}
                width={390}
                height={844}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="hero-scroll-cue pointer-events-none absolute bottom-5 left-1/2 hidden -translate-x-1/2 text-corag-rosa lg:block"
      aria-hidden="true"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none">
        <path
          d="M6 9l6 6 6-6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>
  </section>

  <div id="main-after-hero"></div>

  {/* ── Beats 1 + 2 — the intent exists, the connection fails ─────────── */}
  <section class="bg-corag-bg">
    <div class="main-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-primary"
        >
          {h.problemEyebrow}
        </p>
        <h2
          class="mt-3 font-display text-3xl font-semibold leading-tight text-corag sm:text-4xl"
        >
          {h.problemTitle}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-corag-secondary">
          {h.problemBody}
        </p>
      </div>
      <ul class="mt-10 flex flex-wrap gap-3" role="list">
        {
          h.problemFragments.map((fragment) => (
            <li class="rounded-full border border-corag-border bg-corag-bg-elevated px-4 py-2 text-sm text-corag-text-muted">
              {fragment}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Beat 3 expanded — the bridge ──────────────────────────────────── */}
  <section class="bg-corag-bg-brand">
    <div class="main-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-primary"
        >
          {h.howEyebrow}
        </p>
        <h2
          class="mt-3 font-display text-3xl font-semibold leading-tight text-corag sm:text-4xl"
        >
          {h.howTitle}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-corag-secondary">
          {h.howBody}
        </p>
      </div>
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          h.howSteps.map((step, index) => (
            <li class="relative rounded-[18px] border border-corag-border bg-corag-bg-elevated p-6">
              <span
                class="font-display text-3xl font-bold text-corag-accent"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-lg font-semibold text-corag">
                {step.title}
              </h3>
              <p class="mt-2 text-corag-secondary">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-10">
        <a href={routes.how} class={btnSecondary}>{h.howCta}</a>
      </div>
    </div>
  </section>

  {/* ── Beat 4 — the bridge holds because of evidence ─────────────────── */}
  <section class="bg-corag-bg">
    <div class="main-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-primary"
        >
          {h.trustEyebrow}
        </p>
        <h2
          class="mt-3 font-display text-3xl font-semibold leading-tight text-corag sm:text-4xl"
        >
          {h.trustTitle}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-corag-secondary">
          {h.trustBody}
        </p>
      </div>
      <dl class="mt-12 grid gap-6 md:grid-cols-3">
        {
          h.pillars.map((pillar) => (
            <div class="rounded-[18px] border border-corag-border bg-corag-bg-elevated p-6 shadow-corag-sm">
              <dt class="font-display text-xl font-semibold text-corag">
                {pillar.title}
              </dt>
              <dd class="mt-2 leading-relaxed text-corag-secondary">
                {pillar.body}
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-10">
        <a href={routes.trust} class={btnSecondary}>{h.trustCta}</a>
      </div>
    </div>
  </section>

  {/* ── Beat 5 — Ayuda Directa ────────────────────────────────────────── */}
  <section class="bg-corag-bg-brand-strong">
    <div class="main-container py-16 sm:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <img
          src="/images/home/entrega-mercados-1280.webp"
          srcset="/images/home/entrega-mercados-480.webp 480w, /images/home/entrega-mercados-768.webp 768w, /images/home/entrega-mercados-1280.webp 1280w"
          sizes="(min-width: 1024px) 45vw, 100vw"
          alt=""
          width={1280}
          height={856}
          loading="lazy"
          decoding="async"
          class="w-full rounded-[28px] object-cover shadow-corag-lg"
        />
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-primary"
          >
            {h.productEyebrow}
          </p>
          <h2
            class="mt-3 font-display text-3xl font-bold text-corag sm:text-4xl"
          >
            {h.productTitle}
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-corag-secondary">
            {h.productBody}
          </p>
          <div class="mt-8">
            <a href={APP_URL} class={btnPrimary}>{h.productCta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Interoperability — the developer thesis ───────────────────────── */}
  <section class="bg-corag-bg">
    <div class="main-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-primary"
        >
          {h.devEyebrow}
        </p>
        <h2
          class="mt-3 font-display text-3xl font-semibold leading-tight text-corag sm:text-4xl"
        >
          {h.devTitle}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-corag-secondary">
          {h.devBody}
        </p>
        <div class="mt-8">
          <a href={routes.dev} class={btnSecondary}>{h.devCta}</a>
        </div>
      </div>
    </div>
  </section>

  <BlogPreviewSection lang={lang} />

  {/* ── Beat 6 — the invitation ───────────────────────────────────────── */}
  <section class="bg-corag-bg">
    <div class="main-container pb-20 sm:pb-28">
      <div
        class="rounded-[28px] bg-corag-bg-dark px-6 py-14 text-center sm:px-12 sm:py-16"
      >
        <h2
          class="font-display text-3xl font-bold text-corag-on-fill sm:text-4xl"
        >
          {h.closingTitle}
        </h2>
        <p
          class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-corag-rosa"
        >
          {h.closingBody}
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <a href={APP_URL} class={btnOnDark}>{h.closingCtaApp}</a>
          <a href={routes.team} class={btnGhostOnDark}>{h.closingCtaTeam}</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero-glow {
    background: radial-gradient(
      closest-side,
      var(--color-corag-rosa),
      transparent 70%
    );
    opacity: 0.1;
    filter: blur(48px);
  }

  /* Motion is a whisper, and only for those who did not opt out. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: hero-glow-drift 26s ease-in-out infinite alternate;
    }
    .hero-scroll-cue {
      animation: hero-cue-bounce 2.2s ease-in-out infinite;
    }
  }

  @keyframes hero-glow-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-8rem, 6rem, 0) scale(1.25);
    }
  }

  @keyframes hero-cue-bounce {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 0.4rem);
    }
  }
</style>

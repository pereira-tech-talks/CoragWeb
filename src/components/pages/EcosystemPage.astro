---
/**
 * Ecosystem network page — complementary civic apps around the emergency
 * response. Corag is featured as one node; peers are listed by category.
 * Closing band hosts the DailyBot-backed join form.
 */
import EcosystemJoinForm from '@/components/ecosystem/EcosystemJoinForm.svelte';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { APP_URL } from '@/lib/constances';
import { loadEcosystemDirectory } from '@/lib/ecosystem';
import {
  ECOSYSTEM_CATEGORIES,
  type EcosystemCategory,
} from '@/lib/ecosystem-apps';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const p = t.ecosystemPage;
const prefix = getUrlPrefix(lang);
const { featured, groups } = await loadEcosystemDirectory();

const categoryLabel = (c: EcosystemCategory): string => p.categories[c];

const breadcrumbs = [
  { label: lang === 'es' ? 'Inicio' : 'Home', href: `${prefix}/` },
  { label: p.title },
];

const visitLabel = p.visit;
const whatLabel = p.whatLabel;
const howLabel = p.howLabel;
---

<MainLayout lang={lang} title={p.title} description={p.description}>
  <!-- HERO -->
  <section
    class="relative overflow-hidden border-b border-corag-border bg-corag-bg"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--color-corag-primary-soft)_0%,transparent_55%),radial-gradient(ellipse_at_bottom_left,var(--color-corag-rosa-soft)_0%,transparent_50%)] opacity-90 dark:opacity-40"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-16 top-10 h-64 w-64 rounded-full border border-corag-primary/20 sm:h-96 sm:w-96"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-4 top-28 h-40 w-40 rounded-full border border-corag-accent/30 sm:h-56 sm:w-56"
      aria-hidden="true"
    >
    </div>

    <div class="main-container relative pt-10 pb-4 sm:pt-14">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="main-container relative pb-16 pt-6 sm:pb-24 sm:pt-10">
      <Eyebrow>{p.eyebrow}</Eyebrow>
      <h1
        class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-corag sm:text-5xl lg:text-6xl"
      >
        {p.headline}
      </h1>
      <p
        class="mt-5 max-w-2xl text-lg leading-relaxed text-corag-secondary sm:text-xl"
      >
        {p.lead}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={APP_URL}
          class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-corag-fill px-7 text-base font-semibold text-corag-on-fill transition hover:bg-corag-fill-strong"
          rel="noopener noreferrer"
          target="_blank"
        >
          {p.ctaApp}
        </a>
        <a
          href="#ecosystem-directory"
          class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-corag-border bg-corag-bg/80 px-7 text-base font-semibold text-corag transition hover:border-corag-primary hover:bg-corag-primary-soft"
        >
          {p.ctaDirectory}
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURED CORAG -->
  {
    featured && (
      <section class="bg-corag-fill text-corag-on-fill">
        <div class="main-container py-14 sm:py-20">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-corag-on-fill/80">
            {p.featuredEyebrow}
          </p>
          <div class="mt-6 grid items-center gap-10 lg:grid-cols-12">
            <div class="lg:col-span-7">
              <div class="flex items-center gap-4">
                {featured.data.logo ? (
                  <img
                    src={featured.data.logo}
                    alt=""
                    width="72"
                    height="72"
                    class="h-16 w-16 rounded-2xl bg-corag-on-fill/10 object-contain p-2"
                    loading="eager"
                    decoding="async"
                  />
                ) : null}
                <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
                  {featured.data.name}
                </h2>
              </div>
              <p class="mt-4 text-lg font-medium text-corag-on-fill/95">
                {featured.data.tagline[lang]}
              </p>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-corag-on-fill/85">
                {featured.data.what[lang]}
              </p>
              <p class="mt-3 max-w-2xl text-base leading-relaxed text-corag-on-fill/85">
                {featured.data.how[lang]}
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a
                  href={featured.data.url}
                  class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-corag-on-fill px-7 text-base font-semibold text-corag-fill transition hover:opacity-90"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {p.ctaApp}
                </a>
                <a
                  href={`${prefix}/how-it-works`}
                  class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-corag-on-fill/40 px-7 text-base font-semibold text-corag-on-fill transition hover:bg-corag-on-fill/10"
                >
                  {p.ctaHow}
                </a>
              </div>
            </div>
            <div class="hidden lg:col-span-5 lg:block">
              <div class="relative overflow-hidden rounded-3xl border border-corag-on-fill/20 bg-corag-on-fill/5 p-2 shadow-2xl shadow-black/20">
                <img
                  src={
                    lang === 'en'
                      ? '/images/home/app/app-home-desktop-en-1280.webp'
                      : '/images/home/app/app-home-desktop-1280.webp'
                  }
                  alt={p.featuredImageAlt}
                  width="1280"
                  height="800"
                  class="h-auto w-full rounded-2xl"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- DIRECTORY -->
  <section
    id="ecosystem-directory"
    class="scroll-mt-24 border-b border-corag-border bg-corag-bg"
  >
    <div class="main-container py-14 sm:py-20">
      <Eyebrow>{p.directoryEyebrow}</Eyebrow>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-corag sm:text-4xl">
        {p.directoryTitle}
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-corag-secondary">
        {p.directoryLead}
      </p>

      {
        ECOSYSTEM_CATEGORIES.map((category) => {
          const apps = groups[category];
          if (!apps.length) return null;
          return (
            <div class="mt-14">
              <h3 class="text-xl font-bold text-corag sm:text-2xl">
                {categoryLabel(category)}
              </h3>
              <p class="mt-2 max-w-2xl text-sm text-corag-secondary">
                {p.categoryLeads[category]}
              </p>
              <ul class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                {apps.map((app) => (
                  <li>
                    <article class="group flex h-full flex-col rounded-2xl border border-corag-border bg-corag-bg-elevated p-5 transition duration-300 hover:-translate-y-0.5 hover:border-corag-primary hover:shadow-lg hover:shadow-corag-primary/10 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
                      <div class="flex items-start gap-3">
                        {app.data.logo &&
                        app.data.logoAuthorization !== 'text_only' ? (
                          <img
                            src={app.data.logo}
                            alt=""
                            width="56"
                            height="56"
                            class="h-14 w-14 shrink-0 rounded-xl border border-corag-border bg-corag-primary-soft object-contain p-1.5"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <div
                            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-corag-primary-soft text-sm font-bold text-corag"
                            aria-hidden="true"
                          >
                            {app.data.monogram || app.data.name.slice(0, 2)}
                          </div>
                        )}
                        <div class="min-w-0">
                          <h4 class="text-lg font-semibold text-corag">
                            {app.data.name}
                          </h4>
                          <p class="mt-0.5 text-sm text-corag-secondary">
                            {app.data.tagline[lang]}
                          </p>
                        </div>
                      </div>
                      <p class="mt-4 text-sm leading-relaxed text-corag-secondary">
                        <span class="font-semibold text-corag">{whatLabel}</span>
                        {' '}
                        {app.data.what[lang]}
                      </p>
                      <p class="mt-2 text-sm leading-relaxed text-corag-secondary">
                        <span class="font-semibold text-corag">{howLabel}</span>
                        {' '}
                        {app.data.how[lang]}
                      </p>
                      <div class="mt-auto flex flex-wrap items-center gap-3 pt-5">
                        <a
                          href={app.data.url}
                          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-corag-fill px-5 text-sm font-semibold text-corag-on-fill transition hover:bg-corag-fill-strong"
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {visitLabel}
                        </a>
                        {app.data.apiDocsUrl ? (
                          <a
                            href={app.data.apiDocsUrl}
                            class="text-sm font-medium text-corag-accent-strong underline-offset-2 hover:underline"
                            rel="noopener noreferrer"
                            target="_blank"
                          >
                            {p.apiDocs}
                          </a>
                        ) : null}
                      </div>
                    </article>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }

      <p class="mt-16 max-w-3xl text-sm leading-relaxed text-corag-secondary">
        {p.disclosure}
      </p>
    </div>
  </section>

  <!-- JOIN -->
  <section
    id="ecosystem-join"
    class="scroll-mt-24 bg-corag-primary-soft/35 dark:bg-corag-primary-soft/20"
  >
    <div class="main-container py-14 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <Eyebrow>{p.joinEyebrow}</Eyebrow>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-corag sm:text-4xl">
          {p.joinTitle}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-corag-secondary">
          {p.joinLead}
        </p>
        <div class="mt-8 rounded-3xl border border-corag-border bg-corag-bg p-5 shadow-sm sm:p-8">
          <EcosystemJoinForm client:visible lang={lang} />
        </div>
      </div>
    </div>
  </section>
</MainLayout>

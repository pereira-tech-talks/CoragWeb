---
import type { CollectionEntry } from 'astro:content';

import { type Language, tr } from '@/lib/i18n';

interface Props {
  community: CollectionEntry<'communities'>;
  lang: Language;
  visitLabel: string;
}

const { community, lang, visitLabel } = Astro.props;
const { name, logo, url, focus, description } = community.data;
const focusText = focus ? tr(focus, lang) : undefined;
const descriptionText = tr(description, lang);
const logoDark = logo.dark;
const logoClass = 'max-h-16 max-w-full object-contain object-left';
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  data-umami-event="community_click"
  data-umami-event-slug={community.id}
  class="group flex h-full min-w-0 flex-col rounded-2xl border border-corag-border bg-corag-bg-elevated p-5 sm:p-6 shadow-sm transition hover:border-corag-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-corag-primary"
>
  <div class="flex h-16 w-full min-w-0 items-center">
    {
      logoDark ? (
        <>
          <img
            src={logo.src}
            alt={logo.alt}
            width="160"
            height="64"
            loading="lazy"
            class:list={[logoClass, 'dark:hidden']}
          />
          <img
            src={logoDark}
            alt={logo.alt}
            width="160"
            height="64"
            loading="lazy"
            class:list={[logoClass, 'hidden dark:block']}
          />
        </>
      ) : (
        <img
          src={logo.src}
          alt={logo.alt}
          width="160"
          height="64"
          loading="lazy"
          class={logoClass}
        />
      )
    }
  </div>
  <div class="min-w-0">
    <h3 class="mt-4 text-lg font-bold text-corag group-hover:text-corag-primary dark:group-hover:text-corag-primary-light">
      {name}
    </h3>
    {
      focusText && (
        <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-corag-primary dark:text-corag-primary-light">
          {focusText}
        </p>
      )
    }
  </div>
  <p class="mt-4 flex-1 text-sm text-corag-secondary line-clamp-4">
    {descriptionText}
  </p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-corag-primary dark:text-corag-primary-light">
    {visitLabel}
    <span aria-hidden="true">→</span>
  </span>
</a>
